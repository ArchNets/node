# ==============================================================================
# ArchNet Node — KataBump Environment Variables (.env)
# ==============================================================================

# --- ArchNet Panel Configuration (Required) ---
# Your ArchNet panel URL (e.g. https://panel.yourdomain.com)
API_HOST=https://panel.archnets.com

# Server ID assigned to this node in the ArchNet panel
SERVER_ID=26

# Secret key configured for this node in the ArchNet panel
SECRET_KEY=your-secret-key-here

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# --- Cloudflare Tunnel Configuration (Optional, for 443 HTTPS/TLS) ---
# If you want to access your node via your own domain with full SSL on port 443:
# Create a Cloudflare Tunnel in Cloudflare Zero Trust dashboard, and paste the tunnel token here:
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# --- Binary Auto-Download (Optional) ---
# If you did not upload the compiled 'node' binary in your zip file,
# specify a direct download URL here:
# NODE_DOWNLOAD_URL=https://github.com/archnets/node/releases/latest/download/node-linux-amd64

# --- Note on Port Allocation ---
# In KataBump (Pterodactyl), SERVER_PORT is automatically injected into the environment.
# You do NOT need to set PORT or SERVER_PORT manually here.
# Simply configure your ArchNet panel node inbound port to match the port assigned by KataBump.
